# Copiar a `.env` (NO se versiona) y completar. Mismas variables que REPORTES-AUTOMATIZADOS/backend/.env:
# también se puede usar ese archivo directamente:  python herramientas/bd.py --env ../REPORTES-AUTOMATIZADOS/backend/.env <comando>
# o con la variable DICCIONARIO_ENV. Qué base vive en qué servidor: herramientas/diccionario_bd/config.py (BASES_DE).

# 1. MISH (autenticación de Windows: dejar USER y PASSWORD vacíos). Todas las bases de los SP de reportes:
#    mod_rep, strategos, mod_gpa, mod_sec, storage
MISH_SERVER=
MISH_USER=
MISH_PASSWORD=

# 2. SLC (autenticación de Windows): dwh, dma, csd, intcom, slc
SLC_SERVER=
SLC_USER=
SLC_PASSWORD=

# 3. RCC (autenticación SQL: USER y PASSWORD obligatorios): DBRCC, dbriesgos, DW_Raw_v2, DB<AAAAMM>
RCC_SERVER=
RCC_USER=
RCC_PASSWORD=

# Opcional
# DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
